# Server Configuration
PORT=5000

# Database Driver: 'pg' (PostgreSQL / Supabase / Neon) or 'mysql'
DB_DRIVER=pg

# Connection String for PostgreSQL Cloud (Supabase / Neon / Vercel Postgres / Railway)
DATABASE_URL=postgresql://postgres.xxx:yourpassword@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# Alternatively, discrete parameters:
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_NAME=postgres
